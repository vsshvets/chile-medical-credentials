{
  "type": "object",
  "properties": {
    "lane_id": {"type": "string"},
    "status": {"type": "string", "enum": ["complete", "partial", "blocked"]},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "description": "e.g. L04-C01"},
          "statement": {"type": "string", "description": "The claim in ENGLISH, one sentence, precise about modality (must / may / usually / unknown)."},
          "answers_question": {"type": "array", "items": {"type": "integer"}, "description": "Which of the 7 report sections this serves: 1 teaching, 2 doctor, 3 universities, 4 vacancies, 5 documents, 6 immigration, 7 costs"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low", "contested"]},
          "evidence_type": {"type": "string", "enum": ["primary_law", "official_gov_page", "university_official", "professional_body", "press", "secondary", "inference"]},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {"type": "string"},
                "publisher": {"type": "string"},
                "title": {"type": "string"},
                "date_of_content": {"type": "string", "description": "ISO date the SOURCE was published/updated, or UNDATED"},
                "quote_original": {"type": "string", "description": "VERBATIM Spanish (or Ukrainian) text from that page, 40-300 chars, that carries the claim. Never paraphrase. Never invent."},
                "quote_locator": {"type": "string", "description": "e.g. 'Art. 143 inc. 2' or 'section Aranceles'"}
              },
              "required": ["url", "publisher", "title", "date_of_content", "quote_original", "quote_locator"]
            }
          },
          "regime": {
            "type": "object",
            "properties": {
              "norm": {"type": "string", "description": "Instrument + article, or NONE if not a legal claim"},
              "vigencia": {"type": "string", "description": "In-force date of the cited version, or UNKNOWN"},
              "version_consulted": {"type": "string", "description": "The literal LeyChile 'Texto vigente a' / 'Ultima version' string, or NONE"},
              "regime_side": {"type": "string", "enum": ["PRE", "POST", "NEUTRAL", "UNKNOWN"], "description": "Relative to the 2026-08-17 Decreto 174/2024 change"}
            },
            "required": ["norm", "vigencia", "version_consulted", "regime_side"]
          },
          "trap_flags": {"type": "array", "items": {"type": "string"}},
          "applies_to_her": {"type": "string", "enum": ["yes", "no", "conditional"]},
          "condition": {"type": "string"}
        },
        "required": ["id", "statement", "answers_question", "confidence", "evidence_type", "sources", "regime", "trap_flags", "applies_to_her", "condition"]
      }
    },
    "process_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_no": {"type": "integer"},
          "name": {"type": "string"},
          "actor": {"type": "string"},
          "where": {"type": "string", "enum": ["Ukraine", "Chile", "online", "either"]},
          "requires_presence_in_chile": {"type": "boolean"},
          "requires_rut": {"type": "boolean"},
          "documents": {"type": "array", "items": {"type": "string"}},
          "cost_amount": {"type": "number"},
          "cost_unit": {"type": "string", "description": "UTM | CLP | USD | UAH | none"},
          "cost_as_of": {"type": "string"},
          "duration_days_min": {"type": "integer"},
          "duration_days_max": {"type": "integer"},
          "source_claim_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["step_no", "name", "actor", "where", "requires_presence_in_chile", "requires_rut", "documents", "cost_amount", "cost_unit", "cost_as_of", "duration_days_min", "duration_days_max", "source_claim_ids"]
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "url": {"type": "string"},
          "email": {"type": "string"},
          "phone": {"type": "string"}
        },
        "required": ["name", "role", "url", "email", "phone"]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "how_to_resolve": {"type": "string"},
          "blocking": {"type": "boolean"}
        },
        "required": ["question", "why_it_matters", "how_to_resolve", "blocking"]
      }
    },
    "unknowns_declared": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["lane_id", "status", "claims", "process_steps", "entities", "open_questions", "unknowns_declared"]
}
